      "id": 100,
      "title": "Volumen y errores",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/sec",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "spanNulls": true }
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "title": "Volumen de logs por servicio",
      "description": "Tasa de líneas/segundo emitidas por cada contenedor, ventana 1m. Picos = actividad.",
      "targets": [{
        "expr": "sum by (service) (rate({job=\"docker\", service=~\"$service\", debate_id=~\"$debate_id\"}[1m]))",
        "legendFormat": "{{service}}",
        "datasource": { "type": "loki", "uid": "loki" }
      }],
      "type": "timeseries",
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] },
          "noValue": "0"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "title": "Errores por servicio (5 min)",
      "description": "Líneas que contienen 'error', 'exception' o 'traceback' (case-insensitive) en los últimos 5 minutos.",
      "targets": [{
        "expr": "sum by (service) (count_over_time({job=\"docker\", service=~\"$service\", debate_id=~\"$debate_id\"} |~ \"(?i)error|exception|traceback\"[5m]))",
        "legendFormat": "{{service}}",
        "datasource": { "type": "loki", "uid": "loki" }
      }],
      "type": "stat",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Líneas",
      "type": "row"
    },

