      "id": 3,
      "title": "Errores recientes",
      "description": "Últimas líneas que contienen 'error', 'exception' o 'traceback'.",
      "targets": [{
        "expr": "{job=\"docker\", service=~\"$service\", debate_id=~\"$debate_id\"} |~ \"(?i)error|exception|traceback\"",
        "datasource": { "type": "loki", "uid": "loki" }
      }],
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
