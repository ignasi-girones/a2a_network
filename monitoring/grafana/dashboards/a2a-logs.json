        "dedupStrategy": "none"
      }
    },

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "Búsqueda libre",
      "description": "Filtra por la variable $query si está rellena; si no, muestra todo. Útil para 'openai', 'aporia', 'verdict', etc.",
      "targets": [{
        "expr": "{job=\"docker\", service=~\"$service\", debate_id=~\"$debate_id\"} |~ `(?i)${query:raw}`",
        "datasource": { "type": "loki", "uid": "loki" }
      }],
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": false,
