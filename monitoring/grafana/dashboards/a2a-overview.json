  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "definition": "label_values(a2a_http_requests_total, agent_id)",
        "includeAll": true,
        "multi": true,
        "name": "agent_id",
        "query": "label_values(a2a_http_requests_total, agent_id)",
        "refresh": 2,
        "type": "query",
        "label": "Agente"
      }
    ]
  },
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Peticiones HTTP",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Peticiones totales por agente",
      "description": "Número acumulado de peticiones HTTP recibidas por cada agente (excluyendo /metrics).",
      "targets": [{
        "expr": "sum by (agent_id) (a2a_http_requests_total{agent_id=~\"$agent_id\", path!~\"/metrics.*\"})",
        "legendFormat": "{{agent_id}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Peticiones por status code",
      "description": "Desglose acumulado por código de respuesta HTTP.",
      "targets": [{
        "expr": "sum by (status) (a2a_http_requests_total{agent_id=~\"$agent_id\", path!~\"/metrics.*\"})",
        "legendFormat": "HTTP {{status}}"
      }],
      "type": "piechart",
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "noValue": "0"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Errores HTTP por agente",
      "description": "Total de respuestas 4xx/5xx por agente. Para errores de tools externas (403 Wikipedia, etc.) ver 'Errores MCP' en la sección Debate.",
      "targets": [{
        "expr": "sum by (agent_id) (a2a_http_requests_total{agent_id=~\"$agent_id\", status=~\"[45]..\"}) or vector(0)",
        "legendFormat": "{{agent_id}}"
      }],
      "type": "stat",
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 1 } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "title": "Latencia media por agente",
      "description": "Tiempo medio de respuesta HTTP por agente (excluyendo /metrics).",
      "targets": [{
        "expr": "1000 * sum by (agent_id) (a2a_http_request_duration_seconds_sum{agent_id=~\"$agent_id\", path!~\"/metrics.*\"}) / sum by (agent_id) (a2a_http_request_duration_seconds_count{agent_id=~\"$agent_id\", path!~\"/metrics.*\"})",
        "legendFormat": "{{agent_id}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Errores" }, "properties": [{ "id": "custom.align", "value": "right" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "title": "Detalle errores HTTP (agente / endpoint / status)",
      "description": "Desglose de errores HTTP internos. Vacía = sin errores entre agentes.",
      "targets": [{
        "expr": "sum by (agent_id, path, status) (a2a_http_requests_total{agent_id=~\"$agent_id\", status=~\"[45]..\"})",
        "legendFormat": "",
        "instant": true,
        "format": "table"
      }],
      "type": "table",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "agent_id": "Agente", "path": "Endpoint", "status": "Status", "Value": "Errores" } } },
        { "id": "sortBy", "options": { "fields": [{ "field": "Errores", "desc": true }] } }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 200,
      "title": "Métricas LLM",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 18 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Llamadas LLM totales",
      "targets": [{ "expr": "sum(a2a_llm_calls_total{agent_id=~\"$agent_id\"}) or vector(0)", "legendFormat": "" }],
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] },
          "noValue": "0%"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 18 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tasa error LLM",
      "targets": [{
        "expr": "sum(a2a_llm_calls_total{agent_id=~\"$agent_id\", status=\"error\"}) / sum(a2a_llm_calls_total{agent_id=~\"$agent_id\"})",
        "legendFormat": ""
      }],
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 18 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tokens consumidos",
      "targets": [{ "expr": "sum(a2a_llm_tokens_total{agent_id=~\"$agent_id\"}) or vector(0)", "legendFormat": "" }],
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 10,
      "title": "Latencia media LLM por modelo",
      "description": "Tiempo medio wall-clock de cada llamada LLM. Incluye retries por rate-limit si los hubo.",
      "targets": [{
        "expr": "sum by (model) (a2a_llm_call_duration_seconds_sum{agent_id=~\"$agent_id\"}) / sum by (model) (a2a_llm_call_duration_seconds_count{agent_id=~\"$agent_id\"})",
        "legendFormat": "{{model}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "title": "Tokens por llamada por modelo",
      "description": "Media de tokens (prompt + completion) consumidos en cada llamada, desglosado por modelo.",
      "targets": [{
        "expr": "sum by (model) (a2a_llm_tokens_total{agent_id=~\"$agent_id\"}) / sum by (model) (a2a_llm_calls_total{agent_id=~\"$agent_id\", status=\"ok\"})",
        "legendFormat": "{{model}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 12,
      "title": "Prompt vs Completion tokens por modelo",
      "description": "Tokens de entrada (prompt) vs salida (completion) por modelo. Ratio alto de prompt = prompts largos o contexto excesivo.",
      "targets": [
        { "expr": "sum by (model) (a2a_llm_tokens_total{agent_id=~\"$agent_id\", direction=\"prompt\"})", "legendFormat": "prompt · {{model}}" },
        { "expr": "sum by (model) (a2a_llm_tokens_total{agent_id=~\"$agent_id\", direction=\"completion\"})", "legendFormat": "completion · {{model}}" }
      ],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "id": 13,
      "title": "Llamadas LLM por agente y modelo",
      "targets": [{
        "expr": "sum by (agent_id, model) (a2a_llm_calls_total{agent_id=~\"$agent_id\"})",
        "legendFormat": "{{agent_id}} ({{model}})"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 300,
      "title": "Debate",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
