      "id": 19,
      "title": "Media |Δ belief| por rol",
      "targets": [{
        "expr": "sum by (role_id) (a2a_belief_delta_abs_sum{agent_id=~\"$agent_id\"}) / sum by (role_id) (a2a_belief_delta_abs_count{agent_id=~\"$agent_id\"})",
        "legendFormat": "{{role_id}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 },
      "id": 20,
      "title": "Llamadas MCP por herramienta",
      "targets": [{
        "expr": "sum by (tool) (a2a_mcp_calls_total{agent_id=~\"$agent_id\"})",
        "legendFormat": "{{tool}}"
      }],
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "noValue": "0"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 },
      "id": 21,
      "title": "Errores MCP por tool",
      "description": "Llamadas MCP que devolvieron error (403, timeout, no results, etc). Incluye errores de APIs externas como Wikipedia o arXiv.",
