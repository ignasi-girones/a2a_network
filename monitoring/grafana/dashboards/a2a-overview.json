      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 39 },
      "id": 15,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Duración media",
      "targets": [{
        "expr": "sum(a2a_deliberation_duration_seconds_sum) / sum(a2a_deliberation_duration_seconds_count)",
